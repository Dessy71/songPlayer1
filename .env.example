VITE_SUPABASE_URL=https://neicfighjkzokoxojboz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. Leave EMPTY to stream audio straight from Supabase Storage (default).
# Set it to serve audio from a separate origin instead, e.g. a Cloudflare R2
# bucket behind a custom domain:
#   VITE_AUDIO_CDN_BASE=https://cdn.yourdomain.com
# The base must point at the ROOT of the audio bucket. songs.stream_url keeps
# storing the Supabase URL; the rewrite happens at read time, so clearing this
# variable instantly reverts every track with no migration.
VITE_AUDIO_CDN_BASE=
